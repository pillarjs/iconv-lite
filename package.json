{
    "name": "iconv-lite",
    "description": "Convert character encodings in pure javascript.",
    "version": "1.0.0-alpha.4",
    "license": "MIT",
    "keywords": [
        "iconv",
        "convert",
        "charset",
        "icu"
    ],
    "files": [
        "dist/"
    ],
    "author": "Alexander Shtuchkin <ashtuchkin@gmail.com>",
    "main": "./dist/lib/index-node.js",
    "typings": "./dist/lib/index.d.ts",
    "homepage": "https://github.com/pillarjs/iconv-lite",
    "bugs": "https://github.com/pillarjs/iconv-lite/issues",
    "funding": {
        "type": "opencollective",
        "url": "https://opencollective.com/express"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/pillarjs/iconv-lite.git"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
        "build": "tsc -p tsconfig.build.json",
        "prepare": "npm run build",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "generate": "npm run generate --workspaces --if-present",
        "test": "vitest run",
        "test:node": "vitest run --project node",
        "test:web": "vitest run --project web",
        "test:ci": "vitest run --coverage",
        "test:cov": "vitest run --coverage",
        "test:performance": "vitest bench --run --config vitest.bench.config.js",
        "test:performance:check": "vitest run --config vitest.bench.config.js",
        "test:browser": "vitest run --config vitest.browser.config.js",
        "test:wpt": "node test/wpt/run.js",
        "typegen": "npm run build && node generation/gen-typings.js"
    },
    "browser": {
        "./dist/lib/index-node.js": "./dist/lib/index-web.js"
    },
    "devDependencies": {
        "@exodus/bytes": "1.16.0",
        "@stylistic/eslint-plugin": "^5.1.0",
        "@stylistic/eslint-plugin-js": "^4.1.0",
        "@types/node": "^24.10.3",
        "@vitest/browser-playwright": "^5.1.0",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^9.0.0",
        "iconv": "^3.0.1",
        "iconv-nano": "0.0.22",
        "neostandard": "^0.12.0",
        "playwright": "^1.58.0",
        "typescript": "~5.9.3",
        "unorm": "^1.6.0",
        "vite": "^8.3.6",
        "vitest": "^5.1.0",
        "wpt-runner": "^7.0.0"
    },
    "workspaces": [
        "generation"
    ],
    "type": "module",
    "exports": {
        ".": {
            "browser": {
                "types": "./dist/lib/index-web.d.ts",
                "default": "./dist/lib/index-web.js"
            },
            "node": {
                "types": "./dist/lib/index.d.ts",
                "default": "./dist/lib/index-node.js"
            },
            "default": {
                "types": "./dist/lib/index-web.d.ts",
                "default": "./dist/lib/index-web.js"
            }
        },
        "./web": {
            "types": "./dist/lib/index-web.d.ts",
            "default": "./dist/lib/index-web.js"
        },
        "./encodings/*.js": "./dist/encodings/*.js"
    }
}
