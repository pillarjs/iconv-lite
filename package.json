{
    "name": "iconv-lite",
    "description": "Convert character encodings in pure javascript.",
    "version": "1.0.0-alpha.4",
    "license": "MIT",
    "keywords": [
        "iconv",
        "convert",
        "charset",
        "icu"
    ],
    "files": [
        "backends/",
        "lib/",
        "encodings/",
        "types/"
    ],
    "author": "Alexander Shtuchkin <ashtuchkin@gmail.com>",
    "main": "./lib/index-node.js",
    "typings": "./lib/index.d.ts",
    "homepage": "https://github.com/pillarjs/iconv-lite",
    "bugs": "https://github.com/pillarjs/iconv-lite/issues",
    "funding": {
        "type": "opencollective",
        "url": "https://opencollective.com/express"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/pillarjs/iconv-lite.git"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "generate": "npm run generate --workspaces --if-present",
        "test": "vitest run",
        "test:node": "vitest run --project node",
        "test:web": "vitest run --project web",
        "test:ci": "vitest run --coverage",
        "test:cov": "vitest run --coverage",
        "test:performance": "node --allow-natives-syntax performance/index.js",
        "test:typescript": "tsc && tsc -p test/types/tsconfig.web.json && tsc -p test/types/tsconfig.web.json --module NodeNext --moduleResolution NodeNext --customConditions browser && attw --pack --profile esm-only",
        "test:webpack": "npm pack && mv iconv-lite-*.tgz test/webpack/iconv-lite.tgz && cd test/webpack && npm install && npm run test && rm iconv-lite.tgz && rm -r node_modules",
        "test:wpt": "node test/wpt/run.js",
        "typegen": "node generation/gen-typings.js"
    },
    "browser": {
        "./lib/index-node.js": "./lib/index-web.js"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.2",
        "@exodus/bytes": "1.16.0",
        "@stylistic/eslint-plugin": "^5.1.0",
        "@stylistic/eslint-plugin-js": "^4.1.0",
        "@types/node": "^24.10.3",
        "@vitest/browser-playwright": "^5.1.0",
        "@vitest/coverage-v8": "^5.1.0",
        "bench-node": "^0.10.0",
        "eslint": "^9.0.0",
        "expect-type": "^1.3.0",
        "iconv": "^3.0.1",
        "iconv-nano": "0.0.22",
        "neostandard": "^0.12.0",
        "playwright": "^1.58.0",
        "unorm": "^1.6.0",
        "vite": "^8.3.6",
        "vitest": "^5.1.0",
        "typescript": "~5.9.3",
        "wpt-runner": "^7.0.0"
    },
    "dependencies": {},
    "workspaces": [
        "generation"
    ],
    "type": "module",
    "exports": {
        ".": {
            "browser": {
                "types": "./lib/index-web.d.ts",
                "default": "./lib/index-web.js"
            },
            "node": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index-node.js"
            },
            "default": {
                "types": "./lib/index-web.d.ts",
                "default": "./lib/index-web.js"
            }
        },
        "./web": {
            "types": "./lib/index-web.d.ts",
            "default": "./lib/index-web.js"
        },
        "./encodings/*.js": "./encodings/*.js"
    }
}
