{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "iconv-lite": [
        "./lib/index-node.ts"
      ],
      "iconv-lite/web": [
        "./lib/index-web.ts"
      ],
      "iconv-lite/encodings/*.js": [
        "./encodings/*.ts"
      ]
    },
    "types": [
      "node",
      "vitest/globals"
    ],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "lib/**/*",
    "backends/**/*",
    "encodings/**/*",
    "types/**/*",
    "test/**/*",
    "performance/**/*",
    "vitest*.config.*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test/wpt/upstream"
  ]
}
