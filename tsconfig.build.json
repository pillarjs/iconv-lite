{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "dist",
    "allowImportingTsExtensions": false
  },
  "include": [
    "lib/**/*",
    "backends/**/*",
    "encodings/**/*"
  ]
}
