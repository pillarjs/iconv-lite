{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vitest/globals"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true
  },
  "include": [
    "lib/**/*",
    "backends/**/*",
    "encodings/**/*",
    "types/**/*",
    "test/**/*",
    "performance/**/*",
    "vitest*.config.*"
  ],
  "exclude": ["node_modules", "dist", "test/wpt/upstream"]
}
