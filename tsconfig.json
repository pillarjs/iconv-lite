{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "iconv-lite": [
        "./lib/index-node.ts"
      ],
      "iconv-lite/web": [
        "./lib/index-web.ts"
      ],
      "iconv-lite/encodings/*.js": [
        "./encodings/*.ts"
      ]
    },
    "types": [
      "node",
      "vitest/globals"
    ],
    "noEmit": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "lib/**/*.ts",
    "backends/**/*.ts",
    "encodings/**/*.ts",
    "test/**/*.ts",
    "performance/**/*.ts",
    "generation/**/*.ts",
    "vitest*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test/wpt/upstream"
  ]
}
